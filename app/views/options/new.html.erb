<div>
  <h1>New Option</h1>
  <%= form_with model: @option do |form| %>
    <div>
      <%= form.label :name %>
      <%= form.text_field :name %>
    </div>
    <div>
      <%= form.label :description %>
      <%= form.text_field :description %>
    </div>
    <div>
      <%= form.submit %>
    </div>
  <% end %>
</div>
