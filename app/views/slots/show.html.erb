<div>
  <h1><%= @slot.name %></h1>
  <p><%= @slot.description %></p>

  <hr>

  <div>
    <h1>SPIN!!!</h1>
  </div>

  <div>
    <% @turners.each do |turner| %>
      <h3><%= turner.name %></h3>
      <p><%= turner.description %></p>
      <% if turner.options %>
        <p><%= turner.options.first.name %></p>
      <% end %>
      <a href=<%=turner_path(turner)%>>Edit turner</a>
    <% end %>
  </div>

  <hr>

  <div>
    <%= link_to 'Edit Slot', edit_slot_path(@slot) %>
  </div>

  <hr>

  <div>
    <%= link_to 'Home', root_path%>
  </div>

</div>