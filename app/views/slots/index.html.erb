<div>
  <h1>Choose your slot</h1>
  <div>
    <% @slots.each do |slot| %>
      <a href=<%=slot_path(slot)%>>
        <h3><%= slot.name %></h3>
        <p><%= slot.description %></p>
      </a>

      <hr>
    <% end %>
  </div>
</div>

<div>
  <%= link_to 'Create a new slot', new_slot_path %>
</div>